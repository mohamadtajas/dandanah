{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dandanah",
  "version": "0.1.0",
  "identifier": "app.dandanah.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "دندنة · Dandanah",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Quran, anasheed and free audio for Windows",
    "longDescription": "Dandanah is a light Arabic audio app for Quran recitation, anasheed, live radio and Creative Commons music.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
