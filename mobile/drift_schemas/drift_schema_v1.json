  "fixed_sql": [
    {
      "name": "surahs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"surahs\" (\"number\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"english_name\" TEXT NOT NULL, \"meaning\" TEXT NOT NULL, \"ayah_count\" INTEGER NOT NULL, \"revelation\" TEXT NOT NULL, \"bismillah\" TEXT NULL, PRIMARY KEY (\"number\"));"
        }
      ]
    },
    {
      "name": "ayahs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ayahs\" (\"surah\" INTEGER NOT NULL REFERENCES surahs (number), \"ayah\" INTEGER NOT NULL, \"body\" TEXT NOT NULL, \"juz\" INTEGER NOT NULL, \"page\" INTEGER NOT NULL, \"sajda\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sajda\" IN (0, 1)), PRIMARY KEY (\"surah\", \"ayah\"));"
        }
      ]
    },
    {
      "name": "juzs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"juzs\" (\"number\" INTEGER NOT NULL, \"surah\" INTEGER NOT NULL REFERENCES surahs (number), \"ayah\" INTEGER NOT NULL, \"ayah_count\" INTEGER NOT NULL, PRIMARY KEY (\"number\"));"
        }
      ]
    },
    {
      "name": "quran_pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quran_pages\" (\"number\" INTEGER NOT NULL, \"surah\" INTEGER NOT NULL REFERENCES surahs (number), \"ayah\" INTEGER NOT NULL, PRIMARY KEY (\"number\"));"
        }
      ]
    },
    {
      "name": "adhkar_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"adhkar_categories\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"featured\" INTEGER NOT NULL CHECK (\"featured\" IN (0, 1)), \"streak_key\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "adhkar_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"adhkar_items\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES adhkar_categories (id), \"body\" TEXT NOT NULL, \"repeat_count\" INTEGER NOT NULL, \"source\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
